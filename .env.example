# Development only defaults. Never commit the real .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DATABASE_PATH=./data/registry.sqlite
BACKUP_DIRECTORY=./backups
# Comma-separated exact origins for login and authenticated operations, no paths or wildcard.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Enable the exact TauriTavern origins for Hub account endpoints only.
ENABLE_TAURITAVERN_ORIGINS=false
# Enable only for a loopback-bound service behind a local proxy that overwrites X-MieMie-Client-IP.
TRUST_LOOPBACK_PROXY=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback
# Generate at least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# Private server-side Snowflake allowlist; never put the actual IDs in source.
# Legacy one-time migration only; use Owner console for subsequent roles.
MIEMIE_OWNER_DISCORD_ID=
MIEMIE_ADMIN_DISCORD_IDS=

# Development/test only; production requires app. Never place the PEM inside the release/repository.
GITHUB_AUTH_MODE=anonymous
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
