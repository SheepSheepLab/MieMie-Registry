# Development only defaults. Never commit the real .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DATABASE_PATH=./data/registry.sqlite
BACKUP_DIRECTORY=./backups
# Comma-separated exact origins, no paths or wildcard. Include your Tavern origin.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback
# Generate at least 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# Private server-side Snowflake allowlist; never put the actual IDs in source.
MIEMIE_ADMIN_DISCORD_IDS=
